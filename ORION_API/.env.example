ORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORION_ENABLE_DOCS=false
ORION_MODEL_PATH=app/modules/vision/Modelos/hand_landmarker.task
ORION_MAX_FRAME_BYTES=2000000
ORION_JPEG_QUALITY=70
ORION_DRAW_IDS=false
MAX_FILA=2
ORION_WS_SEND_TIMEOUT_SECONDS=1.0
PORT=8000

# Offline: sem timeout nos WebSockets (31536000 = 1 ano). Em producao, remova estas duas
# linhas para voltar aos padroes (300s de ociosidade e heartbeat a cada 180s).
ORION_WS_IDLE_TIMEOUT_SECONDS=31536000
ORION_WS_HEARTBEAT_SECONDS=31536000

# Banco. Offline: SQLite local (o arquivo e criado sozinho no startup).
DATABASE_URL=sqlite+aiosqlite:///./orion_local.db
# Producao: DATABASE_URL=mysql+pymysql://usuario:senha@host:porta/banco

# Popula dominios, atividades e o usuario fixo no startup. Use false em producao.
ORION_SEED_OFFLINE=true

SECRET_KEY="troque-por-um-segredo-aleatorio"
ALGORITHM="HS256"
# Offline: 525600 (1 ano) para o login nao expirar. Producao: 30.
ACCESS_TOKEN_EXPIRE_MINUTES=525600
